Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Transmettre l'en-tête Authorization (souvent supprimé en CGI/FastCGI)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^app/ - [F,L]
  RewriteRule ^(config\.php|data/) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^(config\.php|cron\.php|\.ftp-deploy.*)$">
  Require all denied
</FilesMatch>
